APP_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/oauth.db
# Admin API
ADMIN_ORIGIN=
ADMIN_DEV_ORIGIN=http://localhost:5173
CHECK_SP_HOST=false
SP_HOST=oauth.mattediworks.com
ADMIN_SESSION_COOKIE=mw_oauth_admin_session
# Project callback-secret encryption
CALLBACK_SECRET_KEYS=
CALLBACK_SECRET_ACTIVE_KEY_VERSION=1

# Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://oauth.mattediworks.com/oauth/google/callback

# Short-lived OAuth transaction encryption
TOKEN_ENCRYPTION_KEY=
