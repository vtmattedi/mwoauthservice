APP_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_PATH=./data/oauth.db
# Admin API
ADMIN_ORIGIN=
ADMIN_DEV_ORIGIN=http://localhost:5173
CHECK_SP_HOST=false
SP_HOST=oauth.mattediworks.com
ADMIN_SESSION_COOKIE=mw_oauth_admin_session

# Admin WebAuthn / passkeys
# Production:
#   WEBAUTHN_RP_ID=oauth.mattediworks.com
#   WEBAUTHN_ORIGINS=https://<admin>.oauth.mattediworks.com
# Local development can use:
#   WEBAUTHN_RP_ID=localhost
#   WEBAUTHN_ORIGINS=http://localhost:5173
WEBAUTHN_RP_ID=oauth.mattediworks.com
WEBAUTHN_RP_NAME=MW OAuth
WEBAUTHN_ORIGINS=
WEBAUTHN_CREDENTIAL_KEYS=
WEBAUTHN_CREDENTIAL_ACTIVE_KEY_VERSION=1
# Project callback-secret encryption
CALLBACK_SECRET_KEYS=
CALLBACK_SECRET_ACTIVE_KEY_VERSION=1

# Per-project Google client secret encryption (MW OAuth v1.1)
# Independent from CALLBACK_SECRET_KEYS: generate separate 32-byte keys, e.g.
#   GOOGLE_CLIENT_SECRET_KEYS=1:<base64url-32-byte-key>
# Keep every historic version here so older credentials stay decryptable, and
# back the keyring up together with the SQLite database.
GOOGLE_CLIENT_SECRET_KEYS=
GOOGLE_CLIENT_SECRET_ACTIVE_KEY_VERSION=1

# Google OAuth provider (legacy global client; keep only during migration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://oauth.mattediworks.com/oauth/google/callback

# Short-lived OAuth transaction encryption
TOKEN_ENCRYPTION_KEY=
